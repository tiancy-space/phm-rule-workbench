# 复制为环境变量使用，不要提交填了真实口令的 .env
PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/phm_rule
DB_USERNAME=phm
DB_PASSWORD=
# 默认 PostgreSQL 驱动。金仓 Oracle 模式改为 com.kingbase8.Driver
DB_DRIVER=org.postgresql.Driver
# 分页方言：postgre_sql 或 kingbase_es
DB_TYPE=postgre_sql
CORS_ALLOWED_ORIGINS=http://localhost:8081
